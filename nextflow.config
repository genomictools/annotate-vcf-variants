
singularity {
  enabled    = true
  autoMounts = true
  runOptions = "--bind /mnt:/mnt --bind /data:/data"
}

process {
  withLabel: 'bcftools' { container = 'bcftools.1.19' }
  withLabel: 'vep'      { container = 'ensembl-vep-110' }
  withLabel: 'spliceai' { container = 'spliceai_1.3.1' }
}

params {
  // Default params
  tool      = 'vep'
  chunk     = 10
  limit     = 30

  // VEP
  species   = 'homo_sapiens'
  assembly  = 'GRCh38'
  cadd      = false
  spliceai  = false
  gnomad    = false

  // SpliceAI
  distance  = 50
  masked    = true
}

profiles {
  // Resource profiles
  local     { includeConfig 'conf/local.config' }
  cluster   { includeConfig 'conf/cluster.config' }
  dynamic   { includeConfig 'conf/dynamic.config' }
  
  // Test profile
  test_vep {
    params {
      tool    = "vep"
      version = "110"
      cadd    = true
      gnomad  = true
    }
  }

  test_spliceai {
    params {
      tool    = "spliceai"
      version = "1.3.1"
    }
  }
}
